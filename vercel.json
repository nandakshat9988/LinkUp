{
  "version": 2,
  "builds": [
    {
      "src": "backend-node/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend-node/server.js"
    },
    {
      "src": "/health",
      "dest": "/backend-node/server.js"
    },
    {
      "src": "/healthz",
      "dest": "/backend-node/server.js"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(style\\.css|app\\.js|login\\.html|register\\.html|dashboard\\.html|activity\\.html|index\\.html)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
